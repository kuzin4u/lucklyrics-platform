# Секреты только здесь и в переменных окружения площадки размещения.
# В код и в браузер не попадают никогда.

PORT=3000
BRAND_CONFIG=config/brand.json

# Хранилище: реализация — storage.provider в конфиге, здесь можно перекрыть.
# Папка файлового хранилища — на постоянный диск, если он есть.
STORE_PROVIDER=
DATA_DIR=

# Площадка (получить в кабинете продавца: Настройки → API-ключи → Seller API, тип Admin)
MARKETPLACE_CLIENT_ID=
MARKETPLACE_API_KEY=

# Платежи
PAYMENT_SHOP_ID=
PAYMENT_SECRET_KEY=

# Модель для AI-помощника — вызывается только сервером
MODEL_API_KEY=

# Авторизация кабинета
JWT_SECRET=
